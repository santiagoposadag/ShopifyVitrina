# ---------------------------------------------------------------------------
# Vitrina environment configuration
#
# PREFERRED FLOW: secrets live GPG-encrypted in gopass and are injected at
# runtime — no .env needed for them:
#   ./scripts/with-secrets.sh docker compose up -d
#   ./scripts/with-secrets.sh npm run dev -w server
# See docs/secrets-management.md for the full setup.
#
# FALLBACK FLOW: copy this file to .env (cp env.sample .env) and fill in the
# values. Compose interpolates a repo-root .env, so everything keeps working.
# ---------------------------------------------------------------------------

# --- Claude Agent SDK -------------------------------------------------------
# The SDK spawns a Claude Code subprocess that reads its endpoint, credential
# and model tiers from the environment, so the agent can be pointed at any
# Anthropic-compatible provider with no code change.
#
# Set ONE of the two credentials. At least one is required; neither is required
# on its own, because a non-Anthropic deployment has no Anthropic key at all.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bearer-token form, used by DeepSeek's Anthropic-compatible endpoint.
ANTHROPIC_AUTH_TOKEN=

# Provider routing. Empty values fall back to Anthropic and claude-haiku-4-5.
# Prefer the ready-made profiles over setting these by hand:
#   ./scripts/with-secrets.sh --profile deepseek npm run dev -w server
# See env.anthropic, env.deepseek, and docs/provider-swap.md.
ANTHROPIC_BASE_URL=
# Model for the agent turn.
MODEL=
# Model for the SDK's OWN utility calls (compaction, summarisation, subagents).
# Defaults to MODEL. Kept separate so the tiers can be split without code.
SMALL_FAST_MODEL=
# Extended thinking budget. >0 enables thinking. Honoured by Anthropic; DeepSeek
# ignores the number (steer its effort with AGENT_EXTRA_BODY instead).
MAX_THINKING_TOKENS=
# JSON object merged into every request body, for provider-specific fields the
# SDK has no option for. Validated at boot — a malformed value fails startup
# rather than silently doing nothing. Single-quote it in a sourced profile.
AGENT_EXTRA_BODY=

# --- Voice notes (speech to text) -------------------------------------------
# Neither Claude nor DeepSeek accepts audio, so an inbound voice note has to be
# transcribed before the agent can answer it. Leave the key unset and voice
# notes get a reply asking the person to write instead — never silence.
#
# OpenAI-shaped /audio/transcriptions endpoint, so Groq, OpenAI or anything
# compatible is a URL change. Groq's whisper-large-v3-turbo is ~$0.04 per hour
# of audio; a 30s note costs about $0.0003.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Per-message cost bound: anything larger is skipped rather than billed. Not a
# rate limiter — transcription runs before the per-phone limiter (voice-notes.md).
TRANSCRIPTION_MAX_BYTES=26214400
# Where voice notes wait to be transcribed. Deliberately NOT inside MEDIA_DIR:
# that directory is served publicly at /media, and private speech must not land
# somewhere a guessable URL reaches. Compose sets this to /data/audio.
AUDIO_DIR=./data/audio

# --- WhatsApp transport ------------------------------------------------------
# Which transport carries messages. Two are supported and both sit behind the
# same WhatsAppChannel seam, so switching is this one variable plus a restart:
#
#   cloud   Meta's official WhatsApp Business Cloud API. Needs a WABA, a
#           verified business and the number REGISTERED with Meta (which means
#           it can no longer be used from the WhatsApp app). Replies are only
#           free-form within 24h of the person's last message; outside that
#           window only an approved template goes through.
#   bridge  The whatsmeow sidecar, paired as a linked device. No onboarding and
#           no per-message fee, and no official standing with Meta either.
#
# Default is bridge, so an existing deployment keeps working untouched.
# Full setup: docs/whatsapp-cloud-api.md
WHATSAPP_PROVIDER=bridge

# --- Meta Cloud API (WHATSAPP_PROVIDER=cloud) --------------------------------
# App secret, from App settings -> Basic in the Meta developers panel. Meta
# signs every webhook with it (X-Hub-Signature-256, HMAC-SHA256 over the raw
# body), and it is the ONLY thing separating a real event from a forged one.
WHATSAPP_APP_SECRET=
# A string you invent. Meta echoes it during the webhook verification handshake
# (GET /webhook) when the callback URL is saved and on every later edit, so it
# has to live here rather than in someone's clipboard. openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# From WhatsApp -> API setup. This is the phone number ID, NOT the number.
WHATSAPP_PHONE_NUMBER_ID=
# SYSTEM USER token from Business Manager, with whatsapp_business_messaging and
# whatsapp_business_management on this WABA. Not the 24-hour panel token: that
# one expires and every reply starts failing mid-conversation.
WHATSAPP_ACCESS_TOKEN=
# Pinned Graph API version, for the same reason SHOPIFY_API_VERSION is pinned.
# Bump it deliberately, to the version the app panel shows.
WHATSAPP_GRAPH_VERSION=v23.0

# --- whatsmeow bridge (WHATSAPP_PROVIDER=bridge) -----------------------------
# Messages travel through the bridge/ sidecar, a linked device speaking the
# WhatsApp Web multidevice protocol. No WhatsApp Business onboarding and no
# per-conversation fee — and no official standing with Meta, so the paired
# number carries a real ban risk.
#
# Signs the events the bridge POSTs to the server's /webhook. HMAC-SHA256
# over the raw request body. Generate: openssl rand -hex 32
BRIDGE_WEBHOOK_SECRET=
# Guards the bridge's /send endpoint. Anyone holding this can send WhatsApp
# messages as the business. Generate: openssl rand -hex 32
BRIDGE_API_TOKEN=
# The number to pair, in bare E.164 digits. Set it and the bridge prints an
# 8-character pairing code to its logs (WhatsApp → Settings → Linked devices →
# Link with phone number). Leave it empty to pair by QR code instead.
BRIDGE_PAIR_PHONE=

# Where the server reaches the sidecar, and the directory the sidecar stages
# decrypted inbound media in. COMPOSE SETS BOTH ITSELF (bridge:3002 and
# /data/inbound) — these values are for running the server outside Docker with
# `npm run dev:server`, where nothing else provides them.
BRIDGE_URL=http://localhost:3002
BRIDGE_STAGING_DIR=./data/inbound

# --- Roles ------------------------------------------------------------------
# Comma-separated list of phone numbers (E.164 digits, no '+') that receive the
# owner toolset. Everyone else is treated as a customer.
OWNER_PHONE_NUMBERS=573001112233,573004445566

# --- Storage ----------------------------------------------------------------
# Path to the SQLite database file (shared with the web storefront).
DB_PATH=./data/vitrina.db
# Directory where product / inbound media files are stored.
MEDIA_DIR=./data/media

# --- Public URL -------------------------------------------------------------
# Public base URL of THIS server (e.g. an ngrok / cloudflared tunnel).
# Product photos live in Shopify, so this is only the origin the /media route
# serves inbound owner photos from while they wait to be uploaded.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- Shopify (the catalog) ---------------------------------------------------
# The store IS the inventory: there is no local products table. Both of the
# first two are REQUIRED — the server refuses to boot without them, on purpose.
# Every product tool would otherwise fail on its first call, and the owner would
# get an apology instead of a startup error.

# The store's myshopify domain. A scheme and a trailing slash are stripped, so
# pasting the browser's address bar works.
SHOPIFY_STORE_DOMAIN=mitienda.myshopify.com

# Admin API access token from a CUSTOM APP installed in the store admin
# (Settings -> Apps and sales channels -> Develop apps). Sent as
# X-Shopify-Access-Token. Scope it to only what the tools use:
#   read_products, write_products          (create / update / delete)
#   read_inventory, write_inventory        (stock counts)
#   read_locations                         (which warehouse a count belongs to)
#   read_publications, write_publications  (publishing to the Online Store)
#   write_files                            (uploading product photos)
# The last three are easy to miss and fail QUIETLY: without the publications
# pair, publishToOnlineStore returns false and the owner is told the product is
# ACTIVE but not visible; without write_files, every photo upload lands in the
# `failed` count. Neither looks like a permissions problem. See
# docs/shopify-setup.md.
# The blast radius of this one string is the whole catalog — prices and stock on
# a live store that takes money. Keep it in gopass, never in a committed file.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pinned Admin API version. Shopify ships quarterly and deprecates on a rolling
# schedule, so this is a deliberate value rather than "latest": an unpinned
# version is an agent that changes behaviour without a deploy. Empty uses the
# pin compiled into server/src/config.ts.
SHOPIFY_API_VERSION=2026-01

# Default inventory location, as a gid (gid://shopify/Location/123456789).
# Only needed when the store has MORE THAN ONE location: with one, the agent
# resolves it silently; with several and this unset, it asks the owner which.
# Never guessed — moving stock out of the wrong warehouse is an error nobody
# notices until a count.
SHOPIFY_LOCATION_ID=

# How long a fetched catalog stays usable for RANKING search results, in ms.
# Price and stock are re-read live for the products actually shown, so this only
# bounds how quickly a brand-new product becomes findable by text. Set 0 to never
# cache — the right setting for a store whose owner edits in the Shopify admin
# while chatting.
CATALOG_CACHE_TTL_MS=60000

# --- Server -----------------------------------------------------------------
PORT=3001

# --- Limits & lifecycle -------------------------------------------------------
# Kill switch for the customer path. Set false to auto-reply that the sales
# assistant is unavailable — non-owner messages never reach the agent (and never
# spend a Claude call). Owners are unaffected. Default true.
CUSTOMER_AGENT_ENABLED=true
# Cost protection for the public-facing agent (owners are always exempt).
# Max agent turns per customer phone per sliding hour.
RATE_LIMIT_PER_PHONE_PER_HOUR=20
# Max customer agent turns per day across all phones (circuit breaker).
RATE_LIMIT_GLOBAL_PER_DAY=500
# Conversations idle longer than this many days start a fresh agent session.
# Idle, not total: every turn refreshes the clock. It also bounds the transcript
# sweep — a transcript past this window can no longer be resumed, so housekeeping
# may delete it once no session row references it.
SESSION_MAX_AGE_DAYS=7

# Where the Agent SDK keeps its conversation transcripts, so housekeeping can
# delete the ones no session row can resume. Compose sets this; leave it unset
# everywhere else. It has NO default on purpose: the path the SDK derives on a
# developer machine is that developer's own Claude Code history for this repo,
# so a default would make `npm run purge:sessions` delete real work. Unset, the
# sweep does nothing. See server/src/data/transcripts.ts.
# AGENT_TRANSCRIPTS_DIR=/home/node/.claude/projects

# --- Message batching ---------------------------------------------------------
# People send one thought per WhatsApp message, so a burst is coalesced into a
# single agent turn instead of one turn (and one Claude call) per message.
# Silence, in ms, that ends a burst. Every new message restarts this timer.
BATCH_DEBOUNCE_MS=8000
# Ceiling, in ms, from the first un-flushed message: someone who never pauses
# still gets a reply instead of waiting for a silence that never comes.
BATCH_MAX_WAIT_MS=45000
# Same two knobs, for a burst that contains photos. WhatsApp uploads a photo set
# in waves — a measured 37-photo listing arrived in two waves 32s apart — so the
# text window would split one property into two conversations. The cost of the
# longer window is that a photo burst waits this long before any reply.
BATCH_MEDIA_DEBOUNCE_MS=45000
BATCH_MEDIA_MAX_WAIT_MS=120000

# --- Docker Compose notes ----------------------------------------------------
# Under `docker compose up`, DB_PATH and MEDIA_DIR above are IGNORED: compose.yaml
# overrides both to /data/vitrina.db and /data/media inside the containers (a
# shared named volume), regardless of what is set here or in .env.
#
# SHOPIFY_STORE_DOMAIN and SHOPIFY_ADMIN_TOKEN must reach the compose shell, not
# just this file: compose.yaml interpolates them with no default, so a bare
# `docker compose up` starts the server with blank values and it fails its boot
# check. Use ./scripts/with-secrets.sh, which exports the token from gopass.
