# ---------------------------------------------------------------------------
# Vitrina environment configuration
#
# PREFERRED FLOW: secrets live GPG-encrypted in gopass and are injected at
# runtime — no .env needed for them:
#   ./scripts/with-secrets.sh docker compose up -d
#   ./scripts/with-secrets.sh npm run dev -w server
# See docs/secrets-management.md for the full setup.
#
# FALLBACK FLOW: copy this file to .env (cp env.sample .env) and fill in the
# values. Compose interpolates a repo-root .env, so everything keeps working.
# ---------------------------------------------------------------------------

# --- Claude Agent SDK -------------------------------------------------------
# API key for the Anthropic API. The Agent SDK reads this to run the model.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp provider ------------------------------------------------------
# Which transport carries messages. Exactly one is live at a time.
#
#   kapso     Meta's Cloud API behind Kapso's proxy. Official, per-conversation
#             pricing, needs WhatsApp Business onboarding.
#   whatsmeow The local bridge sidecar (bridge/), speaking the linked-device
#             protocol. No onboarding, no fees — and no official standing with
#             Meta, so the paired number carries a real ban risk.
#
# Only the ACTIVE provider's credentials below are required; the server refuses
# to boot without them and ignores the other set entirely.
WHATSAPP_PROVIDER=kapso

# --- Kapso (WhatsApp transport) ---------------------------------------------
# API key for the Kapso REST API (sending messages, downloading media).
KAPSO_API_KEY=kapso_live_xxxxxxxxxxxxxxxxxxxx
# The WhatsApp phone number id registered in Kapso (Meta Cloud API phone id).
KAPSO_PHONE_NUMBER_ID=123456789012345
# Secret used to verify inbound webhook HMAC-SHA256 signatures.
KAPSO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- whatsmeow bridge (alternative transport) -------------------------------
# Only needed when WHATSAPP_PROVIDER=whatsmeow. Bring the sidecar up with:
#   ./scripts/with-secrets.sh docker compose --profile whatsmeow up -d
#
# Signs the events the bridge POSTs to the server's /webhook. Same HMAC-SHA256
# scheme the Kapso path already verifies. Generate: openssl rand -hex 32
BRIDGE_WEBHOOK_SECRET=
# Guards the bridge's /send endpoint. Anyone holding this can send WhatsApp
# messages as the business. Generate: openssl rand -hex 32
BRIDGE_API_TOKEN=
# The number to pair, in bare E.164 digits. Set it and the bridge prints an
# 8-character pairing code to its logs (WhatsApp → Settings → Linked devices →
# Link with phone number). Leave it empty to pair by QR code instead.
BRIDGE_PAIR_PHONE=

# --- Roles ------------------------------------------------------------------
# Comma-separated list of phone numbers (E.164 digits, no '+') that receive the
# owner toolset. Everyone else is treated as a customer.
OWNER_PHONE_NUMBERS=573001112233,573004445566

# --- Storage ----------------------------------------------------------------
# Path to the SQLite database file (shared with the web storefront).
DB_PATH=./data/vitrina.db
# Directory where product / inbound media files are stored.
MEDIA_DIR=./data/media

# --- Public URL -------------------------------------------------------------
# Public base URL of THIS server (e.g. an ngrok / cloudflared tunnel).
# Used to build public photo URLs that WhatsApp can fetch.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Public base URL of the STOREFRONT (the web app) — a DIFFERENT host/port from
# PUBLIC_BASE_URL above. Used to build the private preview links the assistant
# sends the owner so they can review a draft before publishing it.
STOREFRONT_BASE_URL=http://localhost:3000

# --- Server -----------------------------------------------------------------
PORT=3001

# --- Limits & lifecycle -------------------------------------------------------
# Kill switch for the customer path. Set false to auto-reply that the sales
# assistant is unavailable — non-owner messages never reach the agent (and never
# spend a Claude call). Owners are unaffected. Default true.
CUSTOMER_AGENT_ENABLED=true
# Cost protection for the public-facing agent (owners are always exempt).
# Max agent turns per customer phone per sliding hour.
RATE_LIMIT_PER_PHONE_PER_HOUR=20
# Max customer agent turns per day across all phones (circuit breaker).
RATE_LIMIT_GLOBAL_PER_DAY=500
# Conversations idle longer than this many days start a fresh agent session.
# Idle, not total: every turn refreshes the clock. It also bounds the transcript
# sweep — a transcript past this window can no longer be resumed, so housekeeping
# may delete it once no session row references it.
SESSION_MAX_AGE_DAYS=7

# Where the Agent SDK keeps its conversation transcripts, so housekeeping can
# delete the ones no session row can resume. Compose sets this; leave it unset
# everywhere else. It has NO default on purpose: the path the SDK derives on a
# developer machine is that developer's own Claude Code history for this repo,
# so a default would make `npm run purge:sessions` delete real work. Unset, the
# sweep does nothing. See server/src/data/transcripts.ts.
# AGENT_TRANSCRIPTS_DIR=/home/node/.claude/projects

# --- Message batching ---------------------------------------------------------
# People send one thought per WhatsApp message, so a burst is coalesced into a
# single agent turn instead of one turn (and one Claude call) per message.
# Silence, in ms, that ends a burst. Every new message restarts this timer.
BATCH_DEBOUNCE_MS=8000
# Ceiling, in ms, from the first un-flushed message: someone who never pauses
# still gets a reply instead of waiting for a silence that never comes.
BATCH_MAX_WAIT_MS=45000
# Same two knobs, for a burst that contains photos. WhatsApp uploads a photo set
# in waves — a measured 37-photo listing arrived in two waves 32s apart — so the
# text window would split one property into two conversations. The cost of the
# longer window is that a photo burst waits this long before any reply.
BATCH_MEDIA_DEBOUNCE_MS=45000
BATCH_MEDIA_MAX_WAIT_MS=120000

# --- Storefront (web workspace) ---------------------------------------------
# The web app reads the SAME SQLite file. Point it at the same DB_PATH.
# Brand name shown across the storefront.
NEXT_PUBLIC_BRAND_NAME=Vitrina
# WhatsApp number for wa.me deep links (E.164 digits, no '+').
NEXT_PUBLIC_WHATSAPP_NUMBER=573001112233

# --- Docker Compose notes ----------------------------------------------------
# Under `docker compose up`, DB_PATH and MEDIA_DIR above are IGNORED: compose.yaml
# overrides both to /data/vitrina.db and /data/media inside the containers (a
# shared named volume), regardless of what is set here or in .env.
#
# NEXT_PUBLIC_BRAND_NAME and NEXT_PUBLIC_WHATSAPP_NUMBER are inlined into the
# web bundle at BUILD time by Next.js. Under Compose they must be set in the
# host shell (or a .env file read by `docker compose`, not the app's .env) so
# they are picked up as build args — see the "web.build.args" block in
# compose.yaml. Changing them later requires a rebuild, not just a restart.
