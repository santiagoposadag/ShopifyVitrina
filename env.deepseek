# ---------------------------------------------------------------------------
# Provider profile: DEEPSEEK (Anthropic-compatible endpoint)
#
#   ./scripts/with-secrets.sh --profile deepseek npm run dev -w server
#   ./scripts/with-secrets.sh --profile deepseek docker compose up -d
#
# Routing config ONLY — no secrets. with-secrets.sh reads the DeepSeek key from
# gopass (vitrina/deepseek_api_key) and exports it as ANTHROPIC_AUTH_TOKEN.
#
# READ docs/provider-swap.md BEFORE CUTTING OVER. This endpoint IGNORES several
# parameters rather than rejecting them, so a misconfiguration here does not
# fail — it silently does something else.
# ---------------------------------------------------------------------------

# DeepSeek's Anthropic-compatible endpoint. Note the /anthropic suffix: their
# OpenAI-format endpoint lives at a different path and speaks a different API.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# The two documented V4 model ids are deepseek-v4-flash and deepseek-v4-pro.
# (deepseek-chat and deepseek-reasoner were deprecated 2026-07-24.)
#
# Set this EXACTLY. An unrecognised model id is not an error on this endpoint —
# it silently resolves to deepseek-v4-flash, so a typo returns a perfectly good
# reply from a model you did not choose. The per-turn log records `servedModel`
# from the response for exactly this reason; compare it against MODEL.
MODEL=deepseek-v4-flash

# The former Haiku tier. Pointed at the same model for now, but kept separate so
# it can be moved to deepseek-v4-pro (or back to a Haiku) without a code change.
SMALL_FAST_MODEL=deepseek-v4-flash

# DEEPSEEK IGNORES thinking.budget_tokens. Setting this changes nothing about
# how much the model reasons here; it is left empty so nobody reads a number
# and believes it took effect. Use AGENT_EXTRA_BODY below instead.
MAX_THINKING_TOKENS=

# The thinking knob that actually reaches DeepSeek.
#
# Merged verbatim into every request body by the bundled CLI
# (CLAUDE_CODE_EXTRA_BODY). `output_config.effort` is DeepSeek's only reasoning
# control, and its floor is "high": "low" and "medium" are silently promoted to
# "high", so the reasoning-latency tax on former Haiku-tier calls CANNOT be
# dialled below this. The only way further down is off:
#
#   AGENT_EXTRA_BODY={"thinking":{"type":"disabled"}}
#
# Do not set effort to "max" via CLAUDE_CODE_EFFORT_LEVEL as DeepSeek's docs
# suggest — SDK 0.1.77 accepts only low|medium|high|<int>|unset there and
# discards "max" without a word. This variable bypasses that entirely.
#
# SINGLE QUOTES ARE REQUIRED. This file is sourced by POSIX sh, which strips
# unquoted double quotes and turns the JSON into {output_config:{effort:high}} —
# not valid JSON, and rejected at boot. Single quotes survive both sh and Node's
# .env parser.
AGENT_EXTRA_BODY='{"output_config":{"effort":"high"}}'
