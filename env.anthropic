# ---------------------------------------------------------------------------
# Provider profile: ANTHROPIC (the default, and the parity baseline)
#
#   ./scripts/with-secrets.sh --profile anthropic npm run dev -w server
#   ./scripts/with-secrets.sh --profile anthropic docker compose up -d
#
# Routing config ONLY — no secrets. The credential comes from gopass via
# with-secrets.sh. See docs/provider-swap.md.
# ---------------------------------------------------------------------------

# Anthropic's own endpoint. This is also the built-in default, so the variable
# is set explicitly here only to make the two profiles read as a pair.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model for the agent turn itself.
MODEL=claude-haiku-4-5

# Model for the SDK's own utility calls (compaction, summarisation, subagents).
# Kept as a SEPARATE value from MODEL even when the two agree, so the tiers can
# be split again without a code change.
SMALL_FAST_MODEL=claude-haiku-4-5

# Extended thinking. Honoured here: on Anthropic the budget is a real budget.
# Unset (or 0) leaves the SDK's own default in place.
MAX_THINKING_TOKENS=

# No provider-specific body fields are needed against Anthropic — the SDK
# already speaks its API natively. Left empty on purpose; see env.deepseek for
# where this earns its keep.
AGENT_EXTRA_BODY=
