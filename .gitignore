# Both forms: the trailing slash matches a DIRECTORY only, so a symlink named
# node_modules slips past it — which is exactly how two self-referential ones
# ended up committed and broke `npm run test` on a fresh checkout.
node_modules/
node_modules
.next/
# Leading slash: the runtime SQLite/media directory at the repo root ONLY.
# Unanchored, this also matched server/src/data/ — real source, silently
# untracked, so a commit would build fine locally and fail in the image.
/data/
.env
*.log
dist/
.DS_Store

.codegraph/
.playwright-mcp/

# Local scratch template for .env (see env.sample for the committed reference)
env.txt

# Go build artifact: `go build ./...` drops the binary next to its source.
/bridge/bridge
